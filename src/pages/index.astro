---
import { Image } from 'astro:assets';
import portrait from '../assets/perfil.jpeg';
import signature from '../assets/assinatura.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterTransition from '../components/ChapterTransition.astro';
import { professional as p } from '../data/professional';
import { content as c } from '../data/content';
import { primaryService, additionalService } from '../data/services';
const services = [primaryService, ...(additionalService ? [additionalService] : [])];
const nav = [['sobre','Sobre mim'],['atendimentos','Atendimentos'],['psicoterapia','Psicoterapia'],['como-funciona','Como funciona'],['duvidas','Dúvidas']];
---
<BaseLayout>
<header class="header"><a class="brand" href="#inicio" aria-label="Natália Menezes — início"><Image src={signature} alt="Natália Menezes" width={250} format="webp" loading="eager"/><span>{p.role} · CRP {p.crp}</span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false" hidden>Menu ☰</button><nav id="navigation" aria-label="Navegação principal">{nav.map(([id,label])=><a href={'#'+id}>{label}</a>)}<a class="nav-contact" href={p.whatsapp}>Vamos conversar? ↗</a></nav></header>
<main id="conteudo">
<section id="inicio" class="hero" data-scene><div class="hero-decoration" aria-hidden="true"><div class="orb"></div><div class="paper paper-one"></div><div class="paper paper-two"></div><div class="paper paper-three"></div><div class="botanical">❋</div></div><div class="hero-content"><p class="hero-kicker">UM ESPAÇO DE ESCUTA, NO SEU TEMPO</p><Image class="hero-signature" src={signature} alt="Natália Menezes" width={600} format="webp" loading="eager"/><p class="identification">{p.name} · {p.role} · CRP {p.crp}</p><div class="fine-line"></div><h1>Um espaço para compreender sua história, <span>no seu tempo.</span></h1><p class="hero-description">Psicoterapia individual online para adultos, com atenção especial às mulheres e pessoas LGBTQIAPN+. Uma escuta que respeita sua história e a singularidade de cada processo.</p><a class="button button-light" href={p.whatsapp}>Vamos conversar? <span aria-hidden="true" >✧</span></a><p class="location">Atendimento particular · Online · Mediante agendamento</p></div><a class="scroll-cue" href="#sobre">Conheça meu trabalho <span aria-hidden="true" >✧</span></a><div class="tear" aria-hidden="true"></div></section>
<ChapterTransition number="01" title="Oi, eu sou Natália!" from="#6B1B2C" to="#F3EDE3"/>
<section id="sobre" class="about section" data-scene><div class="container"><p class="section-label"><span>01</span>SOBRE MIM</p><div class="about-grid"><div class="portrait-column"><div class="postcard"><div class="postcard-inner"><div class="postcard-front"><Image src={portrait} alt="Natália Menezes Reis, psicóloga clínica" widths={[320,480,640,800]} sizes="(max-width:700px) 85vw, 40vw" width={800} format="webp" loading="lazy"/><div class="photo-caption">Uma escuta, no seu tempo.<span class="star" aria-hidden="true" >✧</span></div></div><div class="postcard-back" aria-hidden="true"><span class="star" >✧</span><p>{p.displayName}</p><span>{p.role}<br/>CRP {p.crp}</span><div class="postmark">COM ESCUTA<br/>& CUIDADO</div></div></div></div><button class="flip-button" hidden aria-pressed="false" >↻ Vire este cartão</button><p class="handwritten">Cada história merece espaço.</p></div><div class="editorial"><h2>Oi, eu sou<br/><em>Natália!</em></h2>{c.about.map(t=><p>{t}</p>)}<div class="themes"><span>{p.role}</span><span>CRP {p.crp}</span></div></div></div></div></section>
<ChapterTransition number="02" title="Um olhar atento à sua singularidade." from="#F3EDE3" to="#FDBFD3"/>
<section id="para-quem" class="section audience" data-scene><div class="container"><p class="section-label"><span>02</span>PARA QUEM</p><div class="about-grid"><h2>Um olhar atento<br/>à sua <em>singularidade.</em></h2><div class="editorial">{c.audience.map(t=><p>{t}</p>)}</div></div><ul class="theme-grid">{c.themes.map((t,i)=><li><span aria-hidden="true">0{i+1} /</span><h3>{t}</h3><span class="star" aria-hidden="true" >✧</span></li>)}</ul><p class="theme-note">Esses são exemplos de questões que podem aparecer em psicoterapia. O atendimento não se limita a esses temas.</p><p class="closing">Você não precisa chegar com tudo organizado ou saber exatamente por onde começar. O processo pode ser construído a partir do que faz sentido para você.</p></div></section>
<section id="atendimentos" class="services section" data-scene><div class="container"><p class="section-label"><span>03</span>POSSIBILIDADES DE CUIDADO</p><div class="section-heading"><h2>Um espaço<br/><em>para você.</em></h2><p>Psicoterapia individual online<br/>Atendimento particular</p></div><div class:list={['polaroids',{'single-service':services.length===1}]}>{services.map((s,i)=><article class={'polaroid card-'+i}><div class="service-art"><span class="card-number">0{i+1}</span><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="10" y="17" width="80" height="55" rx="3"/><path d="M40 72v12m20-12v12M29 84h42M43 39c-8-12-21 2 7 19 28-17 15-31 7-19l-7 7Z"/></svg><span class="art-caption">ESCUTA & CUIDADO</span><span class="star" aria-hidden="true" >✧</span></div><h3>{s.title}</h3><p>{s.description}</p><a class="button" href={p.whatsapp}>Vamos conversar? <span aria-hidden="true" >✧</span></a></article>)}</div></div><div class="tear" aria-hidden="true"></div></section>
<ChapterTransition number="04" title="Um passo de cada vez." from="#FDBFD3" to="#F3EDE3"/>
<section id="psicoterapia" class="process section" data-scene><div class="container"><p class="section-label"><span>04</span>PSICOTERAPIA</p><div class="process-grid"><div><h2>Como entendo<br/>a <em>psicoterapia</em></h2><span class="process-flower" aria-hidden="true" >✧</span></div><div class="approach-copy">{c.therapy.map(t=><p>{t}</p>)}</div></div></div></section>
<section id="como-funciona" class="section process-steps" data-scene><div class="container"><p class="section-label"><span>05</span>COMO FUNCIONA</p><div class="section-heading"><h2>Um passo<br/><em>de cada vez.</em></h2><p>Os atendimentos são individuais e realizados<br/>online, mediante agendamento.</p></div><div class="route"><svg viewBox="0 0 1100 160" preserveAspectRatio="none" aria-hidden="true"><path class="route-guide" d="M20 90Q140 0 280 90T550 90T820 90T1080 90"/><path class="route-draw" pathLength="1" d="M20 90Q140 0 280 90T550 90T820 90T1080 90"/></svg><ol class="steps">{c.steps.map((s,i)=><li><span class="step-number">0{i+1}</span><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol></div><a class="button" href={p.whatsapp}>Vamos conversar? <span aria-hidden="true" >✧</span></a></div></section>
<section id="duvidas" class="section"><div class="container faq"><div><p class="section-label"><span>06</span>DÚVIDAS</p><h2>Antes de<br/><em>começar.</em></h2><p>Algumas perguntas sobre o atendimento.</p></div><div>{c.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></div></section>
<ChapterTransition number="07" title="Vamos conversar?" from="#F3EDE3" to="#F4DDE2"/>
<section id="contato" class="contact section" data-scene><div class="container"><p class="section-label"><span>07</span>UM CONVITE AO ENCONTRO</p><div class="contact-postcard"><div><p class="small-heading">PARA: VOCÊ</p><h2>Vamos<br/><em>conversar?</em></h2><p>Você pode me chamar para esclarecer suas dúvidas e receber as orientações para iniciar o acompanhamento.</p><a class="button" href={p.whatsapp}>Vamos conversar? <span aria-hidden="true" >✧</span></a><p class="contact-note">O primeiro passo pode ser uma conversa.</p></div><div class="contact-mark"><div class="stamp" aria-hidden="true"><span class="star" >✧</span><span>COM ESCUTA<br/>& CUIDADO</span></div><address><a href={p.whatsapp}>{p.phone}</a><a href={p.instagramUrl}>{p.instagram}</a><a href={p.emailUrl}>{p.email}</a></address><span class="postcard-lines" aria-hidden="true"></span></div></div></div></section>
</main><footer><div class="container footer-inner"><div><a class="footer-name" href="#inicio">{p.name}</a><p>{p.role} · CRP {p.crp}</p><p>Psicoterapia individual online · Atendimento particular</p><p>© {new Date().getFullYear()} {p.displayName}</p></div><div class="footer-links"><a href={p.instagramUrl}>Instagram ↗</a><a href={p.whatsapp}>WhatsApp ↗</a><a href="#inicio">Voltar ao início ↑</a></div></div><div class="tile-border" aria-hidden="true"></div></footer>
<script>
import '../scripts/paper-motion';
</script>
</BaseLayout>
